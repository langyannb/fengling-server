[Unit]
Description=Fengling Share WebSocket gateway
After=network.target mysql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fengling
EnvironmentFile=/etc/fengling/ws.env
ExecStart=/opt/fengling/fengling-ws
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
